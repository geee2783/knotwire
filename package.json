{
  "name": "knotwire",
  "version": "0.1.0",
  "description": "Knotwire — self-hosted, open-source CRM for messaging-first sales teams (WhatsApp, Messenger, pipelines, dialog engine, AI agent, public API).",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @knotwire/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.20.0",
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
