{
  "name": "knotwire",
  "version": "0.1.0",
  "description": "Knotwire — self-hosted, open-source CRM for messaging-first sales teams (WhatsApp, Messenger, pipelines, dialog engine, AI agent, public API).",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @knotwire/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:setup": "node scripts/db-setup.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.20.0",
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true
  }
}
